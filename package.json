{
    "name": "fuse-api",
    "version": "1.0.0",
    "main": "dist/src/main",
    "scripts": {
        "build": "nest build",
        "start:dev": "nest start --watch",
        "start:prod": "node .",
        "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ormconfig.ts",
        "migration:generate": "npm run typeorm migration:generate",
        "migration:create": "npm run typeorm migration:create",
        "migration:run": "npm run typeorm migration:run",
        "migration:revert": "npm run typeorm migration:revert",
        "test:integration_docker": "jest --config ./jest.config.js --testPathPattern=integration",
        "test:docker": "docker-compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from test_runner > test_output.log 2>&1",
        "test": "npm run test:docker"
    },
    "keywords": [],
    "author": "Daniel Pulgarin",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@nestjs/axios": "^4.0.0",
        "@nestjs/cache-manager": "^3.0.1",
        "@nestjs/common": "^11.0.3",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.0.3",
        "@nestjs/platform-express": "^11.0.3",
        "@nestjs/schedule": "^6.0.0",
        "@nestjs/throttler": "^6.4.0",
        "@nestjs/typeorm": "^11.0.0",
        "@types/nodemailer": "^6.4.17",
        "axios": "^1.9.0",
        "bcrypt": "^6.0.0",
        "cache-manager": "^6.4.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "luxon": "^3.6.1",
        "nodemailer": "^7.0.3",
        "pg": "^8.16.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.24",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.1.2",
        "@types/bcrypt": "^5.0.2",
        "@types/jest": "^29.5.14",
        "@types/luxon": "^3.6.2",
        "@types/nock": "^10.0.3",
        "@types/node": "^22.10.7",
        "@types/pg": "^8.15.2",
        "@types/supertest": "^6.0.3",
        "jest": "^29.7.0",
        "msw": "^2.9.0",
        "nock": "^14.0.5",
        "supertest": "^7.1.1",
        "ts-jest": "^29.3.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3"
    }
}
